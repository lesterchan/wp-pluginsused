<?xml version="1.0"?>
<ruleset name="WP-PluginsUsed">
	<description>WordPress Coding Standards for WP-PluginsUsed.</description>

	<file>.</file>

	<!-- WPCS has no JavaScript sniffs; never let PHPCS touch .js. -->
	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!-- Scanning these makes the CI runner run out of memory. -->
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>

	<rule ref="WordPress"/>

	<config name="text_domain" value="wp-pluginsused"/>
	<config name="minimum_wp_version" value="6.0"/>

	<!-- The tests assert on the plugin's own markup, so they must not escape it. -->
	<rule ref="WordPress.Security.EscapeOutput">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!-- Tests write real fixture plugin files; WP_Filesystem is not appropriate there. -->
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
</ruleset>
